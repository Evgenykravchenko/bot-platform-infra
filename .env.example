# Public CMS address and Tailscale node name
DIRECTUS_PUBLIC_URL=https://bot-content-cms.example.ts.net
TAILSCALE_HOSTNAME=bot-content-cms

# Generated secrets. Never commit real values.
POSTGRES_DB=botcontent
POSTGRES_USER=directus_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DIRECTUS_SECRET=replace-with-a-long-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-long-random-password
DIRECTUS_TOKEN=replace-with-a-long-random-token

# A registry entry, not demo content. Future bots get their own unique key.
DIRECTUS_INITIAL_BOT_KEY=vk-content-bot
DIRECTUS_INITIAL_BOT_NAME=VK Content Bot
DIRECTUS_SEED_DEMO=false

