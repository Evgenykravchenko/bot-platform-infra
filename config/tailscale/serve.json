{
  "TCP": {
    "443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/vk-oauth/": {
          "Proxy": "http://vk-oauth-callback:8787"
        },
        "/": {
          "Proxy": "http://directus:8055"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true
  }
}

